---
export interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="menu-header">
  <h1>{title}</h1>
  {subtitle && <p class="subtitle">{subtitle}</p>}
</div>

<style>
  .menu-header {
    margin-bottom: 0.75rem;
    flex-grow: 1;
  }

  h1 {
    font-size: 3rem;
    margin: 0;
    color: var(--gold);
    text-transform: uppercase;
    font-family: var(--brand-font);
    letter-spacing: 2px;
    text-align: center;
    line-height: 1;
  }


  .subtitle {
    color: var(--white);
    font-size: 1.1rem;
    opacity: 0.8;
    font-style: italic;
    text-align: center;
  }
  
  @media (max-width: 768px) {
    h1 {
      font-size: 2.2rem;
      letter-spacing: 0.5px;
    }
  }
  
  @media (max-width: 480px) {
    h1 {
      font-size: 2.2rem;
      letter-spacing: 0;
    }
  }
</style>