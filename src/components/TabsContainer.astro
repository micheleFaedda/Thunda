---
export interface Tab {
  id: string;
  label: string;
}

export interface Props {
  tabs: Tab[];
  activeTab?: string;
  nested?: boolean;
}

const { tabs, activeTab = tabs[0]?.id, nested = false } = Astro.props;
const containerClass = nested ? 'tabs-container nested-tabs-container' : 'tabs-container';
const tabClass = nested ? 'nested-tab' : 'tab';
---

<div class={containerClass}>
  <div class="tabs">
    {tabs.map((tab, index) => (
      <button 
        class={`${tabClass} ${activeTab === tab.id ? 'active' : ''}`} 
        data-tab={tab.id}
        data-index={index}
      >
        {tab.label}
      </button>
    ))}
    <div class="tab-indicator"></div>
  </div>
  
  <div class="tab-contents">
    <slot />
  </div>
</div>

<style>
  .tabs-container {
    margin-top: 0.5rem;
  }

  .tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    justify-content: center;
    overflow-x: visible;
    overflow-y: visible;
    padding: 0;
    position: relative;
  }

  .nested-tabs-container .tabs {
    overflow: visible;
  }

  .tab-indicator {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    height: 2.5rem;
    background: linear-gradient(135deg, rgba(155, 55, 30, 0.2), rgba(155, 55, 30, 0.1));
    border-radius: 6px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 0;
  }

  .nested-tabs-container .tab-indicator {
    background: linear-gradient(135deg, rgba(155, 55, 30, 0.3), rgba(155, 55, 30, 0.2));
    z-index: 1;
  }
  

  .tab, .nested-tab {
    background: transparent;
    border: none;
    color: var(--white);
    font-family: var(--brand-font);
    font-size: 1em;
    letter-spacing: 0.5px;
    padding: 0.8rem 1.5rem;
    cursor: pointer;
    transition: all 0.3s ease;
    opacity: 0.7;
    white-space: nowrap;
    border-radius: 6px;
    position: relative;
    z-index: 2;
  }

  .tab:hover, .nested-tab:hover {
    opacity: 1;
    transform: scale(1.05);
  }
  
  .tab.active:hover, .nested-tab.active:hover {
    transform: scale(1.08);
  }

  .tab.active, .nested-tab.active {
    opacity: 1;
    color: var(--white);
    background: transparent;
    transform: translateY(0) scale(1.1);
  }

  .tab-contents {
    position: relative;
    overflow-x: visible;
    overflow-y: visible;
  }

  .tab-contents :global(.tab-content) {
    display: none;
    opacity: 0;
    position: absolute;
    width: 100%;
    top: 0;
    left: 0;
    pointer-events: none;
    overflow-x: visible;
    overflow-y: visible;
  }

  .tab-contents :global(.tab-content.active) {
    display: block;
    opacity: 1;
    position: relative;
    pointer-events: auto;
    overflow-x: visible;
    overflow-y: visible;
  }

  .tab-contents :global(.tab-content.transitioning) {
    display: block;
    opacity: 1;
    position: absolute;
    pointer-events: none;
  }

  .tab-contents :global(.tab-content.slide-from-right) {
    display: block;
    opacity: 1;
    animation: slideFromRight 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  .tab-contents :global(.tab-content.slide-from-left) {
    display: block;
    opacity: 1;
    animation: slideFromLeft 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  .tab-contents :global(.tab-content.exit-to-left) {
    display: block;
    opacity: 1;
    animation: exitToLeft 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  .tab-contents :global(.tab-content.exit-to-right) {
    display: block;
    opacity: 1;
    animation: exitToRight 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes slideFromRight {
    from {
      transform: translateX(100%);
      opacity: 1;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  @keyframes slideFromLeft {
    from {
      transform: translateX(-100%);
      opacity: 1;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  @keyframes exitToLeft {
    from {
      transform: translateX(0);
      opacity: 1;
    }
    to {
      transform: translateX(-100%);
      opacity: 1;
    }
  }

  @keyframes exitToRight {
    from {
      transform: translateX(0);
      opacity: 1;
    }
    to {
      transform: translateX(100%);
      opacity: 1;
    }
  }

  @media (max-width: 768px) {
    .tabs {
      gap: 0.3rem;
      padding: 0;
    }

    .tab, .nested-tab {
      padding: 0.6rem 1rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const containers = document.querySelectorAll('.tabs-container');
    
    containers.forEach(container => {
      // Determine if this is a nested container
      const isNested = container.classList.contains('nested-tabs-container');
      const tabSelector = isNested ? '.nested-tab' : '.tab';
      
      // Only select direct children tabs, not nested ones
      const tabsWrapper = container.querySelector('.tabs');
      const tabs = tabsWrapper ? tabsWrapper.querySelectorAll(`:scope > ${tabSelector}`) : [];
      const indicator = container.querySelector('.tab-indicator');
      let currentIndex = 0;

      // Initialize indicator position
      function updateIndicator(tab: HTMLElement) {
        if (!indicator) return;
        const tabRect = tab.getBoundingClientRect();
        const tabsRect = tab.parentElement!.getBoundingClientRect();
        const left = tabRect.left - tabsRect.left;
        
        (indicator as HTMLElement).style.left = `${left}px`;
        (indicator as HTMLElement).style.width = `${tabRect.width}px`;
      }

      // Set initial indicator position
      const activeTab = tabsWrapper?.querySelector(`${tabSelector}.active`) as HTMLElement;
      if (activeTab) {
        // Use setTimeout to ensure DOM is fully rendered
        setTimeout(() => {
          updateIndicator(activeTab);
        }, 0);
        currentIndex = parseInt(activeTab.getAttribute('data-index') || '0');
      }

      // Function to switch to a specific tab
      function switchToTab(newIndex: number) {
        if (newIndex < 0 || newIndex >= tabs.length) return false;
        
        const targetTab = tabs[newIndex];
        if (!targetTab) return false;
        
        const targetId = targetTab.getAttribute('data-tab');
        const previousIndex = currentIndex;
        currentIndex = newIndex;
        
        // Update data-index for proper tracking
        tabs.forEach((t, i) => {
          t.setAttribute('data-index', i.toString());
        });
        
        // Update active tab with slide animation
        tabs.forEach(t => t.classList.remove('active'));
        targetTab.classList.add('active');
        
        // Update indicator position
        updateIndicator(targetTab as HTMLElement);
        
        // Find the content container for this tabs container
        const contentContainer = container.querySelector('.tab-contents');
        if (!contentContainer) return false;
        
        // Update active content with directional animation
        const activeContent = contentContainer.querySelector('.tab-content.active');
        const targetContent = contentContainer.querySelector(`#${targetId}`);
        
        if (activeContent && targetContent && activeContent !== targetContent) {
          // Remove any existing animation/transition classes from all contents
          const allContents = contentContainer.querySelectorAll('.tab-content');
          allContents.forEach(content => {
            content.classList.remove('slide-from-left', 'slide-from-right', 'exit-to-left', 'exit-to-right', 'transitioning');
          });
          
          // Mark old content as transitioning (keeps it visible during animation)
          activeContent.classList.add('transitioning');
          activeContent.classList.remove('active');
          
          // Add directional animation classes
          if (currentIndex > previousIndex) {
            // Moving right: old content exits left, new content enters from right
            activeContent.classList.add('exit-to-left');
            targetContent.classList.add('slide-from-right');
          } else if (currentIndex < previousIndex) {
            // Moving left: old content exits right, new content enters from left
            activeContent.classList.add('exit-to-right');
            targetContent.classList.add('slide-from-left');
          }
          
          // Make new content active
          targetContent.classList.add('active');
          
          // Clean up after animation completes
          setTimeout(() => {
            activeContent.classList.remove('transitioning', 'exit-to-left', 'exit-to-right');
            targetContent.classList.remove('slide-from-left', 'slide-from-right');
          }, 300);
        }
        
        return true;
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => {
          switchToTab(index);
        });
      });

      // Add swipe gesture support
      const contentContainer = container.querySelector('.tab-contents');
      if (contentContainer) {
        let touchStartX = 0;
        let touchStartY = 0;
        let touchEndX = 0;
        let touchEndY = 0;
        const minSwipeDistance = 50;

        contentContainer.addEventListener('touchstart', (e) => {
          const touchEvent = e as TouchEvent;
          if (touchEvent.touches && touchEvent.touches[0]) {
            touchStartX = touchEvent.touches[0].clientX;
            touchStartY = touchEvent.touches[0].clientY;
            touchEndX = touchStartX; // Initialize end position
            touchEndY = touchStartY;
          }
        }, { passive: true });

        contentContainer.addEventListener('touchmove', (e) => {
          const touchEvent = e as TouchEvent;
          if (touchEvent.touches && touchEvent.touches[0]) {
            touchEndX = touchEvent.touches[0].clientX;
            touchEndY = touchEvent.touches[0].clientY;
          }
        }, { passive: true });

        contentContainer.addEventListener('touchend', (e) => {
          // Don't process if we didn't get a proper swipe
          if (touchStartX === 0 && touchStartY === 0) return;
          
          const swipeDistanceX = touchEndX - touchStartX;
          const swipeDistanceY = Math.abs(touchEndY - touchStartY);
          
          // Only process horizontal swipes (ignore vertical scrolling)
          if (Math.abs(swipeDistanceX) > minSwipeDistance && Math.abs(swipeDistanceX) > swipeDistanceY) {
            // Stop propagation to prevent parent containers from also processing this swipe
            e.stopPropagation();
            if (swipeDistanceX > 0) {
              // Swiped right - go to previous tab
              if (currentIndex > 0) {
                // Not at first tab, go to previous tab in current level
                switchToTab(currentIndex - 1);
              } else if (currentIndex === 0 && isNested) {
                // Only at the FIRST nested tab, try to go to parent tab
                const parentContainer = container.closest('.tab-content')?.parentElement?.parentElement;
                if (parentContainer && parentContainer.classList.contains('tabs-container')) {
                  const parentTabs = parentContainer.querySelectorAll('.tabs > .tab');
                  const currentParentTab = parentContainer.querySelector('.tab.active');
                  if (currentParentTab && parentTabs.length > 0) {
                    const parentIndex = Array.from(parentTabs).indexOf(currentParentTab);
                    if (parentIndex > 0) {
                      // Switch to previous parent tab
                      (parentTabs[parentIndex - 1] as HTMLElement).click();
                    }
                  }
                }
              }
            } else if (swipeDistanceX < 0) {
              // Swiped left - go to next tab
              if (currentIndex < tabs.length - 1) {
                switchToTab(currentIndex + 1);
              }
            }
          }
          
          // Reset touch positions
          touchStartX = 0;
          touchStartY = 0;
          touchEndX = 0;
          touchEndY = 0;
        }, { passive: true });
      }

      // Update indicator on resize
      window.addEventListener('resize', () => {
        const activeTab = tabsWrapper?.querySelector(`${tabSelector}.active`) as HTMLElement;
        if (activeTab) {
          updateIndicator(activeTab);
        }
      });

      // For nested tabs, also update indicator when parent tab becomes visible
      if (isNested) {
        const observer = new MutationObserver((mutations) => {
          mutations.forEach((mutation) => {
            if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
              const target = mutation.target as HTMLElement;
              if (target.classList.contains('active') && target.classList.contains('tab-content')) {
                // Parent tab content became active, update nested tab indicator
                setTimeout(() => {
                  const activeNestedTab = tabsWrapper?.querySelector(`${tabSelector}.active`) as HTMLElement;
                  if (activeNestedTab) {
                    updateIndicator(activeNestedTab);
                  }
                }, 50);
              }
            }
          });
        });

        // Observe parent container for class changes
        const parentContent = container.closest('.tab-content');
        if (parentContent) {
          observer.observe(parentContent, { attributes: true, attributeFilter: ['class'] });
        }
      }
    });
  });
</script>