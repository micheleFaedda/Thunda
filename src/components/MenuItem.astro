---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { plateIcon } from '../constants/menuIcons';

export interface Props {
  name: string;
  description?: string | undefined;
  price: string;
  image?: string | ImageMetadata | undefined; // Can be string URL or imported image module
  defaultIcon?: string | undefined;
}

const { name, description, price, image, defaultIcon: customDefaultIcon } = Astro.props;

const defaultIcon = customDefaultIcon || plateIcon;

// Check if image is a string (URL) or an imported module
const isImageUrl = typeof image === 'string';

---

<div class="menu-item">
  {image ? (
    <div class="item-image">
      {isImageUrl ? (
        <img 
          src={image} 
          alt={name}
          width="160"
          height="160"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <Image 
          src={image} 
          alt={name}
          width={160}
          height={160}
          loading="lazy"
          decoding="async"
        />
      )}
    </div>
  ) : (
    <div class="item-icon" set:html={defaultIcon} />
  )}
  <div class="item-content">
    <h3>{name}</h3>
    {description && <p class="description">{description}</p>}
  </div>
  <div class="item-price">
    <span class="price">{price}</span>
  </div>
</div>

<style>
  .menu-item {
    display: flex;
    gap: 0.5rem;
    padding: 0.5rem;
    background: linear-gradient(135deg, rgba(70, 55, 30, 0.15), rgba(70, 55, 30, 0.05));
    border-radius: 8px;
    border: 1px solid transparent;
    transition: all 0.3s ease;
    position: relative;
  }
  
  .menu-item::after {
    content: '';
    position: absolute;
    bottom: -0.5px;
    left: 50%;
    transform: translateX(-50%);
    width: 30%;
    height: 1px;
    background: var(--red);
    opacity: 0.2;
  }
  
  .menu-item:last-child::after {
    display: none;
  }
  
  .menu-item:hover {
    background: linear-gradient(135deg, rgba(70, 55, 30, 0.25), rgba(70, 55, 30, 0.1));
    border-color: rgba(155, 55, 30, 0.3);
    transform: scaleX(1.02);
  }
  
  
  .item-icon {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.8;
    align-self: center;
  }
  
  .item-icon :global(svg) {
    width: 100%;
    height: 100%;
    stroke: var(--white);
    fill: none;
    stroke-width: 1.5;
  }
  
  .item-image {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    align-self: center;
    overflow: hidden;
    border-radius: 8px;
  }
  
  .item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  
  .item-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .menu-item h3 {
    font-size: 1.3rem;
    margin: 0;
    color: var(--white);
    font-family: var(--brand-font);
    text-transform: capitalize;
    letter-spacing: 0.5px;
  }

  .description {
    color: var(--white);
    opacity: 0.8;
    line-height: 1.4;
    margin: 0;
    text-align: justify;
  }
  
  .item-price {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    width: 3ch;
    flex-shrink: 0;
  }

  .price {
    font-weight: 400;
    color: var(--white);
    font-size: 1rem;
    white-space: nowrap;
    opacity: 0.9;
  }
  
  @media (max-width: 600px) {
    .menu-item {
      gap: 0.5rem;
    }
    
    .item-icon {
      width: 60px;
      height: 60px;
    }
    
    .item-image {
      width: 60px;
      height: 60px;
    }
    
    .menu-item h3 {
      font-size: 1.1rem;
    }
    
    .price {
      font-size: 0.95rem;
    }
  }
</style>