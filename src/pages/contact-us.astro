            <h2 class="section-header">Dove Siamo</h2>
            <div class="contact-link">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <div>
                <p>Viale Cristoforo Colombo, 2D</p>
                <p>09125 Cagliari (CA)</p>
              </div>
            </div>
          </div>
        </a>

        <a href="tel:0704649121" class="contact-card-link">
          <div class="contact-card">
            <h2 class="section-header">Telefono</h2>
            <div class="contact-link">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <p>070 464 9121</p>
            </div>
          </div>
        </a>

        <a href="mailto:info@pbread.it" class="contact-card-link">
          <div class="contact-card">
            <h2 class="section-header">Email</h2>
            <div class="contact-link">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <p>info@pbread.it</p>
            </div>
          </div>
        </a>

        <a href="https://wa.me/393293232979" target="_blank" rel="noopener noreferrer" class="contact-card-link">
          <div class="contact-card">
            <h2 class="section-header">WhatsApp</h2>
            <div class="contact-link">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.149-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              <p>+39 329 323 2979</p>
            </div>
          </div>
        </a>
      </section>

      <section class="map-section">
        <h2 class="section-header">Dove Trovarci</h2>
        <div class="map-container">
          <iframe 
            class="map-iframe"
            src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d386.42848409042836!2d9.1162374!3d39.2104471!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12e733f64736f29b%3A0xaa22cbe25fe2fd8b!2sPbread%20Natural%20Bakery!5e0!3m2!1sen!2ssi!4v1756882503236!5m2!1sen!2ssi" 
            width="100%" 
            height="400" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </div>
      </section>

      <section class="hours-section">
        <h2 class="section-header">Orari di Apertura</h2>
        <div class="hours-grid">
          <div class="hours-item">
            <span class="day">Martedì - Domenica</span>
            <span class="time">19:00 - 23:30</span>
          </div>
          <div class="hours-item closed">
            <span class="day">Lunedì</span>
            <span class="time">Chiuso</span>
          </div>
        </div>
      </section>

      <section class="social-section">
        <h2 class="section-header">Seguici</h2>
        <div class="social-links">
          <a href="https://wa.me/393293232979" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
