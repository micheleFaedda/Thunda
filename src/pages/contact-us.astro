            </svg>
          </a>
          <a href="https://www.instagram.com/mr_pbread" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM5.838 12a6.162 6.162 0 1112.324 0 6.162 6.162 0 01-12.324 0zM12 16a4 4 0 110-8 4 4 0 010 8zm4.965-10.405a1.44 1.44 0 112.881.001 1.44 1.44 0 01-2.881-.001z"/>
            </svg>
          </a>
          <a href="https://www.facebook.com/pbreadnaturalbakery/" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
        </div>
      </section>

      <section class="reservation-section">
        <h2 class="section-header">Prenota un Tavolo</h2>
        <p>Vuoi assicurarti un posto nella nostra pizzeria?</p>
        <a href={BOOK_REDIRECT} target="_blank" rel="noopener noreferrer" class="book-button">
          Prenota Ora
        </a>
      </section>
    </div>
  </div>
</Layout>

<style>
  .contact-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 8rem 2rem 3rem;
    color: var(--white);
    min-height: 100vh;
  }


  .content {
    line-height: 1.8;
    font-family: var(--base-font);
  }

  section {
    margin-bottom: 1.5rem;
    padding-bottom: 0;
  }

  h2 {
    font-family: var(--brand-font);
    font-size: 1.5rem;
    margin-bottom: 1rem;
    text-transform: uppercase;
    text-align: center;
  }

  .contact-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .contact-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
    transition: transform 0.3s ease;
  }

  .contact-card-link:hover {
    transform: scale(1.05);
  }

  .contact-card-link:hover .contact-card {
    background: rgba(255, 255, 255, 0.08);
  }

  .contact-card-link:hover .contact-link {
    color: var(--gold);
  }

  .contact-card {
    background: rgba(255, 255, 255, 0.05);
    padding: 1rem;
    border-radius: 0.5rem;
    text-align: center;
    transition: background 0.3s ease;
    height: 100%;
  }

  .contact-card h2 {
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
  }

  .contact-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    color: var(--white);
    opacity: 0.9;
    transition: all 0.3s ease;
  }
  
  /* Special alignment for address icon */
  .contact-card:first-child .contact-link {
    align-items: flex-start;
  }

  .contact-link svg {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
  }

  .contact-link p {
    margin: 0;
    line-height: 1.3;
  }

  .map-section {
    margin-bottom: 2rem;
  }

  .map-container {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    overflow: hidden;
    border-radius: 0.5rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
    line-height: 0;
  }

  .map-iframe {
    width: 100%;
    height: 400px;
    border: 0;
    border-radius: 0.5rem;
    display: block;
  }

  .hours-section {
    text-align: center;
    margin-bottom: 2rem;
  }

  .hours-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 400px;
    margin: 0 auto;
  }

  .hours-item {
    display: flex;
    justify-content: space-between;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 0.5rem;
  }

  .hours-item.closed {
    opacity: 0.7;
  }

  .day {
    font-weight: bold;
    color: var(--white);
  }

  .time {
    color: var(--gold);
  }

  .social-section {
    text-align: center;
    margin-bottom: 2rem;
  }

  .social-links {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    margin-top: 1rem;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    transition: all 0.3s ease;
  }

  .social-links a:hover {
    background: var(--gold);
    transform: scale(1.1);
  }

  .social-links a svg {
    fill: var(--white);
    transition: fill 0.3s ease;
  }

  .social-links a:hover svg {
    fill: var(--brown);
  }

  .reservation-section {
    text-align: center;
    padding: 2rem;
    background: rgba(155, 55, 30, 0.2);
    border-radius: 0.5rem;
  }

  .reservation-section h2 {
    font-family: var(--brand-font);
  }

  .reservation-section p {
    margin: 1rem 0;
    opacity: 0.9;
    font-family: var(--brand-font);
  }

  .book-button {
    display: inline-block;
    background-color: var(--gold);
    color: var(--brown);
    padding: 1rem 2rem;
    border-radius: 0.5rem;
    text-decoration: none;
    font-weight: bold;
    text-transform: uppercase;
    transition: all 0.3s ease;
    margin-top: 1rem;
    font-family: var(--brand-font);
  }

  .book-button:hover {
    background-color: var(--white);
    transform: scale(1.05);
  }

  @media screen and (max-width: 768px) {
    .contact-container {
      padding: 6rem 1.5rem 2rem;
    }


    h2 {
      font-size: 1.3rem;
    }

    .content {
      line-height: 1.6;
    }

    .contact-info {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 480px) {
    .contact-container {
      padding: 5rem 1rem 1.5rem;
    }



    .social-links a {
      width: 40px;
      height: 40px;
    }

    .social-links a svg {
      width: 20px;
      height: 20px;
    }
  }
</style>
