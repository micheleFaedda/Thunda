---
import Layout from '../layouts/Layout.astro';
import { BOOK_REDIRECT } from '../constants';
import '@styles/page-title.css';
---

<Layout>
  <div class="contact-container">
    <h1 class="page-title">Contatti</h1>
    
    <div class="content">
      <section class="contact-info">
        <a href="https://maps.app.goo.gl/mDKfv4KFkKoR4Jc16" target="_blank" rel="noopener noreferrer" class="contact-card-link">
