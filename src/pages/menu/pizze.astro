---
import Layout from '@layouts/Layout.astro';
import MenuPage from '@components/MenuPage.astro';
import { pizzaClassicheIcon, pizzaStagionaliIcon, pizzaCrispIcon } from '../../constants/menuIcons';
import { loadMenuData } from '../../utils/menuLoader';

// Load menu data from YAML
const menuData = await loadMenuData('pizze');

// Map icons to tabs
const iconMap: Record<string, string> = {
  'crisp': pizzaCrispIcon,
  'classiche': pizzaClassicheIcon,
  'stagionali': pizzaStagionaliIcon
};

// Add icons to tabs
const tabs = menuData.tabs?.map(tab => ({
  ...tab,
  icon: iconMap[tab.id] || ''
})) || [];
---

<Layout title="Pizze - Menu - Tundha">
  <MenuPage title={menuData.title} tabs={tabs} />
</Layout>

