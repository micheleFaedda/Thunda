---
import Layout from '@layouts/Layout.astro';
import MenuPage from '@components/MenuPage.astro';
import { beerIcon } from '../../constants/menuIcons';
import { loadMenuData } from '../../utils/menuLoader';

// Load menu data from YAML
const menuData = await loadMenuData('birre');

// Use items directly (no tabs)
const menuItems = menuData.items || [];
---

<Layout title="Birre - Menu - Tundha">
  <MenuPage title={menuData.title} items={menuItems} defaultIcon={beerIcon} />
</Layout>