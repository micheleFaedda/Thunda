---
import Layout from '@layouts/Layout.astro';
import MenuPage from '@components/MenuPage.astro';
import { coffeeIcon, glassIcon } from '../../constants/menuIcons';
import { loadMenuData } from '../../utils/menuLoader';

// Load menu data from YAML
const menuData = await loadMenuData('analcolici-caffetteria');

// Map icons to tabs
const iconMap: Record<string, string> = {
  'analcolici': glassIcon,
  'caffetteria': coffeeIcon
};

// Add icons to tabs
const tabs = menuData.tabs?.map(tab => ({
  ...tab,
  icon: iconMap[tab.id] || ''
})) || [];
---

<Layout title="Analcolici & Caffetteria - Menu - Tundha">
  <MenuPage title={menuData.title} tabs={tabs} />
</Layout>